# ── HealthSherpa ────────────────────────────────────────────────────────────
# Self-serve key from https://one.healthsherpa.com/. Quoting works with a
# free-tier key; enrollment endpoints require partnership onboarding.
# With this UNSET the app serves fixture plans and counties and shows a
# "Fixture data" badge, so the UI can be worked on without a key.
HEALTHSHERPA_API_KEY=

# ── Zoho CRM ────────────────────────────────────────────────────────────────
# Service-account model: ONE connection for the whole app, because field agents
# have no Zoho accounts. See SOFTWARE_SCOPE.md section 2.
#
# With these UNSET the app serves fixture Jots and shows the "Fixture data"
# badge — nothing reaches the CRM.
#
# Register a SERVER-BASED APPLICATION at https://api-console.zoho.com/ — not a
# Self Client, because Zoho allows only one per account and this org has one.
#
# Authorized redirect URIs (both, matched byte for byte):
#   http://localhost:3000/api/auth/zoho/callback
#   https://im-agents.vercel.app/api/auth/zoho/callback
#
# The refresh token is obtained by an admin pressing "Connect the CRM" in the
# app and stored AES-256-GCM encrypted in the database. There is deliberately
# NO environment-variable path for it: one source of truth, and a live CRM then
# requires DATABASE_URL, which makes "stubbed identity reading real client
# data" impossible rather than merely guarded against.
#
# Scopes requested:
#
#   ZohoCRM.modules.custom.READ     read the JOTS module
#   ZohoCRM.modules.custom.CREATE   file new enrollment forms
#   ZohoCRM.modules.custom.UPDATE   apply agent corrections
#   ZohoCRM.coql.READ               the scoped pipeline query
#   ZohoCRM.settings.fields.READ    picklist values, so the app stops
#                                   hard-coding them (see README)
#
# Do NOT grant DELETE. Nothing in this app deletes a CRM record, and the
# service account should not be able to.
#
# Use the DC-correct hosts. For a .com org the defaults below are right; for
# .eu / .in / .com.au change BOTH hosts together.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Only needed if the app is behind a proxy that rewrites the origin.
ZOHO_REDIRECT_URI=
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
ZOHO_API_HOST=https://www.zohoapis.com

# ── Database ────────────────────────────────────────────────────────────────
# Postgres for agent accounts, sessions, server-side drafts, and the submission
# replay buffer. Migrations in db/, applied in order.
#
# Vercel Postgres and Neon are the SAME engine — Vercel Postgres is Neon
# underneath — so one connection string covers both the "Neon" choice and the
# Vercel project's own database. Use the pooled connection string for the app
# and the direct one for migrations.
#
# With this UNSET, auth stays stubbed to one agent and drafts stay in the
# browser. Nothing else changes.
DATABASE_URL=

# Encrypts secrets at rest: the Zoho refresh token and draft SSNs. 32 bytes, hex:
#   openssl rand -hex 32
# Rotating this makes existing drafts undecryptable, which is survivable —
# they expire in 14 days — but it will orphan any in flight.
APP_ENCRYPTION_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Prototype only. Real auth is SOFTWARE_SCOPE.md section 4.1.
#
# This name is what gets written to Submitting_Field_Agent and what the pipeline
# query filters on, so with live Zoho it MUST match this agent's entry in the
# `Agent` global picklist exactly. A name that is not on the picklist is
# silently dropped by Zoho, and the agent then sees an empty pipeline.
# GET /api/health warns about exactly this case.
PROTOTYPE_AGENT_NAME=Dana Ruiz

i-understand-this-is-unauthenticated
